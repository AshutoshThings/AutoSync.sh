#!/usr/bin/env bash

#Load Config files
CONFIG_FILE="$HOME/.config/autosync/autosync.conf"
if [[ ! -f "$CONFIG_FILE" ]]; then
    echo "Error: Config not found at $CONFIG_FILE"
    exit 1
fi
source "$CONFIG_FILE"

DELAY=${DELAY:-5}
POLL_INTERVAL=180

if [[ -n "$LOG_FILE" ]]; then
    touch "$LOG_FILE"
fi

log() {
    local msg="[$(date '+%m-%d %H:%M:%S')] $1"
    echo "$msg"
    [[ -n "$LOG_FILE" ]] && echo "$msg" >> "$LOG_FILE"
}

notify() {
    if command -v notify-send &> /dev/null; then
        notify-send "AutoSync" "$1" --icon=drive-harddisk >/dev/null 2>&1 || true
    fi
}

log "AutoSync Daemon Started"
log "Watching: $LOCAL_DIR"
log "Remote:   $REMOTE_NAME:$REMOTE_DIR"

log "Running startup check..."
if ! rclone bisync "$LOCAL_DIR" "$REMOTE_NAME:$REMOTE_DIR" --verbose; then
    log "State mismatch detected. Forcing full resync..."
    rclone bisync "$LOCAL_DIR" "$REMOTE_NAME:$REMOTE_DIR" --resync --verbose
fi



while true; do
    inotifywait -r -e modify,create,delete,move "$LOCAL_DIR" --exclude '\.git' -t "$POLL_INTERVAL" 2>/dev/null
    EXIT_CODE=$?

    SYNC_NEEDED=false

    if [ $EXIT_CODE -eq 0 ]; then
        log "Local change detected! Debouncing for $DELAY seconds..."
        sleep $DELAY
        SYNC_NEEDED=true
    elif [ $EXIT_CODE -eq 2 ]; then
        SYNC_NEEDED=false
    fi
    
    if [ "$SYNC_NEEDED" = true ]; then
        log "Syncing local changes..."
        if rclone bisync "$LOCAL_DIR" "$REMOTE_NAME:$REMOTE_DIR" --verbose; then
            log "Sync complete."
            notify "Sync Successful"
        else
            log "Sync Error (check logs)"
            notify "Sync Failed"
        fi
    else
        rclone bisync "$LOCAL_DIR" "$REMOTE_NAME:$REMOTE_DIR" >/dev/null 2>&1 || log "Remote check/Heartbeat failed"
    fi
done